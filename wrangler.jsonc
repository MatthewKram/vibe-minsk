{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibe-minsk",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "RealtimeHub" }
    ]
  },
  "exports": {
    "RealtimeHub": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "SUPABASE_URL": "https://oqjtaukwtzvhygdikdcd.supabase.co",
    "TELEGRAM_BOT_USERNAME": "vibeminsk_bot",
    "TELEGRAM_APP_SHORT_NAME": "app",
    "APP_URL": "https://vibe-minsk.mamazaxist9797.workers.dev",
    "ALLOW_DEV_AUTH": "false",
    "ENVIRONMENT": "production"
  },
  "secrets": {
    "required": ["SUPABASE_SECRET_KEY", "TELEGRAM_BOT_TOKEN"]
  }
}
