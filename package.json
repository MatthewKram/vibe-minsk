{
  "name": "vibe-minsk-cloudflare-v17",
  "version": "17.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:client": "vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check": "npm run structure && npm run chat:isolation && npm run realtime:check && npm run typecheck && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "cf:login": "wrangler login",
    "secret:supabase": "wrangler secret put SUPABASE_SECRET_KEY",
    "secret:telegram": "wrangler secret put TELEGRAM_BOT_TOKEN",
    "structure": "node scripts/structure-check.mjs",
    "chat:isolation": "node scripts/no-chat-telegram-check.mjs",
    "realtime:check": "node scripts/realtime-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/vue-query": "^5.102.8",
    "hono": "^4.13.7",
    "maplibre-gl": "^6.9.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.35.0",
    "@types/node": "^22.15.0"
  }
}
